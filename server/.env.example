# Workshoply Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/workshoply

# Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Razorpay Configuration (Test Mode credentials from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# In development mode, set to true to enable the safe Razorpay test payment simulator
# when real Razorpay merchant credentials have not yet been provided.
ALLOW_TEST_PAYMENT_SIMULATOR=true
